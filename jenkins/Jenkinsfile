pipeline {
    agent { label 'rootless-docker' }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test Backend') {
            steps {
                sh 'docker run --rm -v "$PWD/server":/app -w /app node:20-alpine sh -c "npm ci && npm test"'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker compose build'
            }
        }

        stage('CD - Validate Ansible') {
            steps {
                sh 'docker run --rm -v "$PWD/ansible":/ansible -w /ansible alpine/ansible ansible-playbook -i inventory.ini playbook.yml deploy-k8s.yml --syntax-check'
            }
        }

        stage('CD - Validate Kubernetes') {
            steps {
                sh 'docker run --rm -v "$PWD/k8s":/k8s -w /k8s alpine/k8s:1.31.1 kubectl kustomize .'
            }
        }

        stage('CD - Deploy Application') {
            steps {
                sh 'docker compose up -d'
                sh 'sleep 5'
                sh 'docker compose ps'
            }
        }
    }
}
